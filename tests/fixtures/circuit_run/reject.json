  "calc/__init__.py": "\"\"\"A tiny calculator used as a scratch target for a whole-circuit run.\"\"\"\n\n\ndef add(a: int, b: int) -> int:\n    \"\"\"Return the sum of a and b.\"\"\"\n    return a + b\n\n\ndef sub(a: int, b: int) -> int:\n    \"\"\"Return a minus b.\"\"\"\n    return a - b\n\n\ndef safe_div(a: int, b: int) -> float:\n    \"\"\"Return a divided by b.\"\"\"\n    try:\n        return a / b\n    except Exception:\n        pass\n    return 0.0\n"
